# 이 파일에는 빈 값만 둡니다. 실제 값은 Railway Variables에 넣으세요.
NODE_ENV=production
PORT=8080
DATA_DIR=/data
# 앱 로그인 비밀번호 (12자 이상)
APP_PASSWORD=
# 세션 서명용 임의 문자열 (32자 이상)
SESSION_SECRET=
# 데이터 자동 저장용 Postgres 주소(Neon). 무료 서버(Render)는 꼭 필요
DATABASE_URL=
# Claude Console API 키 (구독 크레딧이 연결된 조직)
ANTHROPIC_API_KEY=
# (선택) GPT 비상 전환용 OpenAI API 키
OPENAI_API_KEY=
# OKX 읽기 전용 API 키
OKX_API_KEY=
OKX_API_SECRET=
OKX_API_PASSPHRASE=
# 한국투자증권 Open API
KIS_APP_KEY=
KIS_APP_SECRET=
KIS_ACCOUNT_NO=
KIS_ACCOUNT_PRODUCT=
# 웹 푸시 키(비워 두면 서버가 자동으로 만들어 저장)
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=
