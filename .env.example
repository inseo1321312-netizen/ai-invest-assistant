# 이 파일에는 빈 값만 둡니다. 실제 값은 서버 설정(Render Environment 등)에 넣으세요.
NODE_ENV=production
PORT=8080
DATA_DIR=/data
# 앱 로그인 비밀번호 (12자 이상)
APP_PASSWORD=
# 세션 서명용 임의 문자열 (32자 이상)
SESSION_SECRET=
# 데이터 자동 저장용 Postgres 주소(Neon). 무료 서버(Render)는 꼭 필요
DATABASE_URL=
# Claude Console API 키 (구독 크레딧이 연결된 조직)
ANTHROPIC_API_KEY=
# (선택) GPT 비상 전환용 OpenAI API 키
OPENAI_API_KEY=
# 한국투자증권 Open API 앱키(시세·순위·지수용. 계좌번호는 쓰지 않음). 코인은 키가 필요 없음
KIS_APP_KEY=
KIS_APP_SECRET=
# 웹 푸시 키(비워 두면 서버가 자동으로 만들어 저장)
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=
